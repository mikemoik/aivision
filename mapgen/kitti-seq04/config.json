{
  "map_name": "kitti-seq04",
  "frame": {
    "provenance": "ORB-SLAM3 seq04 world (cam0 frame0, X-right Y-down Z-fwd, metric)"
  },
  "bindata": [
    { "name": "orb-slam3-stereo", "kind": "binary", "dest": "bin/stereo_kitti",
      "url": null, "note": "built locally from external/orb_slam3" }
  ],
  "input": {
    "odometry": "bindata/input/odometry",
    "oxts": "bindata/input/oxts"
  },
  "steps": [
    { "role": "slam",         "type": "ORB3",                   "params": { "baseline_m": 0.5372, "sensor": "stereo" } },
    { "role": "depth",        "type": "inv-depth-fused-mono-rho-gf", "params": {} },
    { "role": "segmentation", "type": "mapillary-vistas",       "params": {} },
    { "role": "lanes",        "type": "egolanes+gray-stereo",   "params": { "z_max": 40, "dz": 2.0 } },
    { "role": "objects",      "type": "vistas+gtsrb+delineator","params": { "pole_eps": 2.5, "sign_conf": 0.40, "gp_conf": 0.25 } },
    { "role": "markings",     "type": "rlmd+lanemodel",         "params": { "conf": 0.25, "cluster_eps": 2.0 } },
    { "role": "georef",       "type": "umeyama+gnss",           "params": { "with_scale": true, "enu_offset_m": [0.20, 1.37, 0.0] } },
    { "role": "assemble",     "type": "ingest-v1",              "params": {} }
  ]
}
